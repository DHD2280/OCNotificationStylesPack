                android:bottomLeftRadius="14dp"
                android:bottomRightRadius="@dimen/oc_radius_right"
                android:topLeftRadius="@dimen/oc_radius_right"
                android:topRightRadius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="4.0dip"
        android:end="4.0dip"
        android:start="4.0dip"
        android:top="4.0dip">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/system_neutral1_50" />
            <corners
                android:bottomLeftRadius="10dp"
                android:bottomRightRadius="@dimen/oc_radius_left"
                android:topLeftRadius="@dimen/oc_radius_left"
                android:topRightRadius="10dp" />
        </shape>
    </item>
