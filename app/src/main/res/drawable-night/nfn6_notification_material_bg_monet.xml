<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:colorControlHighlight">
    <item>
        <shape>
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:end="24dp"
        android:start="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0.0"
                android:endColor="@android:color/system_accent1_600"
                android:startColor="@android:color/system_accent1_600" />
            <corners
                android:bottomLeftRadius="@dimen/oc_radius_right"
                android:bottomRightRadius="@dimen/oc_radius_right"
                android:topLeftRadius="@dimen/oc_radius_left"
                android:topRightRadius="@dimen/oc_radius_left" />
        </shape>
    </item>
    <item
        android:end="24dp"
        android:start="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners
                android:bottomLeftRadius="@dimen/oc_radius_right"
                android:bottomRightRadius="@dimen/oc_radius_right"
                android:topLeftRadius="@dimen/oc_radius_left"
                android:topRightRadius="@dimen/oc_radius_left" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:end="12dp"
        android:start="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0.0"
                android:endColor="@android:color/system_accent1_600"
                android:startColor="@android:color/system_accent1_600" />
            <corners
                android:bottomLeftRadius="@dimen/oc_radius_right"
                android:bottomRightRadius="@dimen/oc_radius_right"
                android:topLeftRadius="@dimen/oc_radius_left"
                android:topRightRadius="@dimen/oc_radius_left" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:end="12dp"
        android:start="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners
                android:bottomLeftRadius="@dimen/oc_radius_right"
                android:bottomRightRadius="@dimen/oc_radius_right"
                android:topLeftRadius="@dimen/oc_radius_left"
                android:topRightRadius="@dimen/oc_radius_left" />
        </shape>
    </item>
    <item android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/system_neutral2_800" />
            <corners android:radius="@dimen/oc_radius_right" />
        </shape>
    </item>
</ripple>